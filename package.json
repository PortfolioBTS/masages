{
  "name": "nyxo-messenger",
  "version": "2.0.0",
  "description": "Secure anonymous messenger with post-quantum E2EE, onion service, and disappearing messages",
  "main": "server.js",
  "scripts": {
    "audit:check": "node scripts/audit-check.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check-env": "node scripts/check-env.js",
    "test": "node test/run-unit.js",
    "test:e2e": "node test/e2e/run.js",
    "test:e2e:docker": "node test/e2e/run.js --docker",
    "test:browser": "node test/browser/run.js",
    "test:all": "node test/run-unit.js && node test/e2e/run.js",
    "dev:local": "node scripts/dev-local.js --docker"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "messenger",
    "anonymous",
    "e2ee",
    "tor",
    "privacy",
    "secure",
    "disappearing-messages",
    "metadata-stripping"
  ],
  "author": "PortfolioBTS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PortfolioBTS/masages.git"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "multer": "^2.4.0",
    "pg": "^8.21.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3"
  }
}
