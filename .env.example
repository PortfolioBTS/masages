SESSION_SECRET=your_random_secret_min_32_chars
DATABASE_URL=postgresql://user:pass@localhost:5432/nyxo

# Ключ шифрования текста сообщений перед записью в БД (AES-256-GCM).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Без него сервер не запустится (см. lib/message-crypto.js).
# Потеряешь ключ — все старые сообщения станут нечитаемыми, храни его так же
# бережно, как SESSION_SECRET/пароль от БД (менеджер секретов, не в git).
MESSAGE_ENCRYPTION_KEY=
# Ротация: новый ключ — в MESSAGE_ENCRYPTION_KEY, старые — сюда (через
# запятую, только для расшифровки уже записанных сообщений).
# MESSAGE_ENCRYPTION_KEY_PREVIOUS=

NODE_ENV=development
PORT=3000
# На Railway для private network (tor-service) — HOST=::
HOST=0.0.0.0

# TLS к Postgres в production: цепочка CA (получить: DUMP_CA=true npm start).
# Без неё production стартует только для хоста *.railway.internal или при
# явном DB_TLS_INSECURE=true.
# DB_CA_CERT=
# DB_TLS_INSECURE=false

# Размер пула соединений с PostgreSQL (по умолчанию 10)
# PG_POOL_MAX=10

# Вложения: папка (по умолчанию ./uploads, на Railway — путь volume) и квота:
# объём загрузок одного пользователя за окно в 30 суток (по умолчанию 500).
# UPLOADS_DIR=/data/uploads
# UPLOAD_QUOTA_MB=500

# Срок жизни инвайт-кода комнаты, часов (по умолчанию неделя)
# INVITE_TTL_HOURS=168

# Дополнительные разрешённые источники (свои домены-зеркала), через запятую
# ALLOWED_ORIGINS=https://nyxo.example

# Proof-of-work при регистрации, бит (8..28)
# POW_DIFFICULTY=18

# Onion-сервис (см. tor-service/README.md): адрес без http:// и внутренний
# порт, на который подключается tor-service (наружу не публиковать).
# ONION_ADDRESS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.onion
# ONION_PORT=3001

# Disappearing messages
# DEFAULT_MESSAGE_EXPIRY_SECONDS > 0 — срок жизни всех новых сообщений, если у
# группы или чата нет своего таймера (его задают участники: POST /api/chats/:id/expiry)
DEFAULT_MESSAGE_EXPIRY_SECONDS=0
# Как часто фоновый воркер удаляет просроченные сообщения
CLEANUP_INTERVAL_MS=60000

# Cloudflare IP ranges (опционально, для кастомизации)
# CF_IP_RANGES=173.245.48.0/20,103.21.244.0/22

# --- Безопасность сервера, мониторинг, security.txt ---
# Смена SESSION_SECRET сбрасывает лимиты (регистрация, вход по коду, ключи),
# CSRF-токены и выданные задачи proof-of-work: они выводятся из этого секрета.

# Мониторинг: GET /healthz (процесс жив) и GET /readyz (миграции завершены,
# база отвечает) открыты — healthcheck хостинга нужно направить на /readyz.
# GET /metrics (Prometheus) отдаётся только с заголовком
# "Authorization: Bearer <токен>"; без токена или без этой переменной — 404.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# METRICS_TOKEN=

# HSTS preload (max-age 2 года, includeSubDomains, preload) — только для
# СВОЕГО домена и только если https работает на всех его поддоменах: заявка
# в список браузеров отменяется месяцами. Действует лишь в production по https.
# HSTS_PRELOAD=yes

# /.well-known/security.txt (RFC 9116). Адреса связи через запятую
# (https://…, mailto:…, tel:+…); по умолчанию — GitHub Security Advisories
# репозитория. Срок — ISO 8601, не дальше года; без него срок скользящий
# (конец суток через 180 дней). PUBLIC_ORIGIN (https://домен без пути) даёт
# поле Canonical; без него поле не выводится.
# SECURITY_CONTACT=mailto:security@example.org
# SECURITY_TXT_EXPIRES=2027-03-01
# PUBLIC_ORIGIN=https://nyxo.example

# Журнал ключей (прозрачность ключей, docs/security/key-transparency.md): ключ подписи
# журнала, base64 PKCS#8 Ed25519. Без него журнал выключен, клиенты работают как раньше.
# Сгенерировать: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# Хранить отдельно от SESSION_SECRET и MESSAGE_ENCRYPTION_KEY, не выводить из них, копия обязательна.
# Сброс базы данных требует НОВОГО ключа. Плановая смена: новый ключ — сюда, прежний — в
# KT_SIGNING_KEY_PREVIOUS (сервер подпишет им заявление о смене), позже убрать.
# Длина эпохи и поколения — константы протокола, переменных для них нет.
# KT_SIGNING_KEY=
# KT_SIGNING_KEY_PREVIOUS=

# Аварийное снятие service worker (закрепление кода клиента, docs/ops/service-worker.md).
# yes — /sw.js отдаёт скрипт, который удаляет кэши закрепления и снимает регистрацию у
# клиентов (ключи шифрования не затрагиваются). Включать только при поломке закрепления;
# после исправления убрать — закрепление включится заново при следующем визите.
# SW_KILL_SWITCH=yes

# Не переменная сервиса: сторож клиентского кода включается переменной РЕПОЗИТОРИЯ GitHub
# WATCHDOG_URL (Settings, Secrets and variables, Actions, Variables) = https://<домен>.
# Пока её нет, ежедневная сверка продакшена с релизом выключена (docs/dev/ci.md, docs/VERIFY.md).
