SESSION_SECRET=change_me_to_random_64_char_string
DATABASE_URL=postgresql://user:pass@localhost:5432/messenger
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
ANON_SERVICE_URL=http://127.0.0.1:8080

# Опционально, только для NODE_ENV=production.
# Цепочка сертификатов для проверки TLS-соединения с Postgres (вместо
# rejectUnauthorized=false). Получить: запустить сервер один раз с DUMP_CA=true
# и переменной DATABASE_URL, скопировать выведенный PEM сюда.
# DB_CA_CERT=

# Опционально. Переопределяет список подсетей Cloudflare, которым доверяем
# заголовок CF-Connecting-IP (см. https://www.cloudflare.com/ips/). Через запятую.
# CF_IP_RANGES=
